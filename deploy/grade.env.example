# Install as /etc/grade/grade.env, owned by root and mode 0600.
# This file contains no secrets. Keep host-specific configuration outside the checkout.
GRADE_DATA_DIR=/var/lib/grade
GRADE_WEB_DIR=/opt/grade/app/apps/web/dist
GRADE_MAX_ACTIVE_JOBS=1

# Same-origin deployment needs no CORS origins. Set this only if the web app and API
# intentionally use different origins.
# GRADE_ALLOWED_ORIGINS=https://grade.example.com
